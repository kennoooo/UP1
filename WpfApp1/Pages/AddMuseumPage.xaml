<Page x:Class="WpfApp1.Pages.AddMuseumPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Музей">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="TextHeader" Style="{DynamicResource HeaderText}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Название" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TBName" Grid.Row="0" Grid.Column="1" MaxLength="100" ToolTip="Название музея (от 2 до 100 символов)"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Город" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TBCity" Grid.Row="1" Grid.Column="1" MaxLength="50" ToolTip="Город (только буквы, пробел и дефис)" PreviewTextInput="TBCity_PreviewTextInput"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="ButtonSave" Content="Сохранить" ToolTip="Сохранить данные" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonClean" Content="Очистить" ToolTip="Очистить поля формы" Click="ButtonClean_Click"/>
        </StackPanel>
    </StackPanel>
</Page>
