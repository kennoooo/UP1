<Page x:Class="WpfApp1.Pages.MuseumsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица музеев">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" HorizontalAlignment="Center">
            <Grid>
                <TextBox x:Name="SearchBox" Width="220" MaxLength="100" ToolTip="Поиск по названию музея" TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="HintSearch" Text="Поиск по названию" Style="{DynamicResource HintText}"/>
            </Grid>
            <ComboBox x:Name="CmbCity" Width="220" ToolTip="Фильтр по городу" SelectionChanged="Filter_SelectionChanged"/>
            <ComboBox x:Name="CmbSort" Width="220" ToolTip="Сортировка по названию" SelectionChanged="Filter_SelectionChanged"/>
            <Button x:Name="ButtonClear" Content="Очистить фильтр" ToolTip="Сбросить поиск, фильтр и сортировку" Click="ButtonClear_Click"/>
        </WrapPanel>

        <DataGrid x:Name="DataGridMuseums" Grid.Row="1" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Город" Binding="{Binding City}" Width="250"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ButtonAdd" Content="Добавить" ToolTip="Добавить музей" Click="ButtonAdd_Click"/>
            <Button x:Name="ButtonEdit" Content="Редактировать" ToolTip="Редактировать выбранный музей" Click="ButtonEdit_Click"/>
            <Button x:Name="ButtonDel" Content="Удалить" ToolTip="Удалить выбранный музей" Click="ButtonDel_Click"/>
        </StackPanel>
    </Grid>
</Page>
