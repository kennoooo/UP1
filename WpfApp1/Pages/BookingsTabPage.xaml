<Page x:Class="WpfApp1.Pages.BookingsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица бронирований">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" HorizontalAlignment="Center">
            <Grid>
                <TextBox x:Name="SearchBox" Width="220" MaxLength="100" ToolTip="Поиск по выставке или ФИО пользователя" TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="HintSearch" Text="Поиск по выставке или ФИО" Style="{DynamicResource HintText}"/>
            </Grid>
            <ComboBox x:Name="CmbMuseum" Width="220" DisplayMemberPath="Name" ToolTip="Фильтр по музею" SelectionChanged="Filter_SelectionChanged"/>
            <ComboBox x:Name="CmbSort" Width="220" ToolTip="Сортировка" SelectionChanged="Filter_SelectionChanged"/>
            <Button x:Name="ButtonClear" Content="Очистить фильтр" ToolTip="Сбросить поиск, фильтр и сортировку" Click="ButtonClear_Click"/>
        </WrapPanel>

        <DataGrid x:Name="DataGridBookings" Grid.Row="1" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding Users.FIO}" Width="*"/>
                <DataGridTextColumn Header="Музей" Binding="{Binding Museums.Name}" Width="*"/>
                <DataGridTextColumn Header="Выставка" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Билетов" Binding="{Binding Num}" Width="90"/>
                <DataGridTextColumn Header="Цена, руб." Binding="{Binding Price, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Сумма, руб." Binding="{Binding Total, StringFormat=N2}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ButtonAdd" Content="Добавить" ToolTip="Добавить бронирование" Click="ButtonAdd_Click"/>
            <Button x:Name="ButtonEdit" Content="Редактировать" ToolTip="Редактировать выбранное бронирование" Click="ButtonEdit_Click"/>
            <Button x:Name="ButtonDel" Content="Удалить" ToolTip="Удалить выбранное бронирование" Click="ButtonDel_Click"/>
        </StackPanel>
    </Grid>
</Page>
