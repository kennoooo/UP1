<Page x:Class="WpfApp1.Pages.UsersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица пользователей">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" HorizontalAlignment="Center">
            <Grid>
                <TextBox x:Name="SearchBox" Width="220" MaxLength="100" ToolTip="Поиск по ФИО или логину" TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="HintSearch" Text="Поиск по ФИО или логину" Style="{DynamicResource HintText}"/>
            </Grid>
            <ComboBox x:Name="CmbRole" Width="220" ToolTip="Фильтр по роли" SelectionChanged="Filter_SelectionChanged"/>
            <ComboBox x:Name="CmbSort" Width="220" ToolTip="Сортировка по ФИО" SelectionChanged="Filter_SelectionChanged"/>
            <Button x:Name="ButtonClear" Content="Очистить фильтр" ToolTip="Сбросить поиск, фильтр и сортировку" Click="ButtonClear_Click"/>
        </WrapPanel>

        <DataGrid x:Name="DataGridUsers" Grid.Row="1" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}" Width="*"/>
                <DataGridTextColumn Header="Фото" Binding="{Binding Photo}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ButtonAdd" Content="Добавить" ToolTip="Добавить пользователя" Click="ButtonAdd_Click"/>
            <Button x:Name="ButtonEdit" Content="Редактировать" ToolTip="Редактировать выбранного пользователя" Click="ButtonEdit_Click"/>
            <Button x:Name="ButtonDel" Content="Удалить" ToolTip="Удалить выбранного пользователя" Click="ButtonDel_Click"/>
        </StackPanel>
    </Grid>
</Page>
