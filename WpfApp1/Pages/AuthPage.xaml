<Page x:Class="WpfApp1.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Source="/res/logo.png" Height="120" Margin="0,0,0,5"/>
        <TextBlock Text="Авторизация" Style="{DynamicResource HeaderText}"/>

        <StackPanel x:Name="LoginPanel">
            <Grid>
                <TextBox x:Name="TextBoxLogin" MaxLength="20" ToolTip="Введите логин" TextChanged="TextBoxLogin_TextChanged" PreviewTextInput="TextBoxLogin_PreviewTextInput"/>
                <TextBlock x:Name="HintLogin" Text="Логин" Style="{DynamicResource HintText}"/>
            </Grid>
            <Grid>
                <PasswordBox x:Name="PassBox" MaxLength="30" ToolTip="Введите пароль" PasswordChanged="PassBox_PasswordChanged" PreviewTextInput="PassBox_PreviewTextInput"/>
                <TextBlock x:Name="HintPass" Text="Пароль" Style="{DynamicResource HintText}"/>
            </Grid>
            <Button x:Name="ButtonEnter" Content="Вход" ToolTip="Войти в систему" Click="ButtonEnter_Click"/>
            <Button x:Name="ButtonReg" Content="Регистрация" ToolTip="Создать новую учетную запись" Click="ButtonReg_Click"/>
            <Button x:Name="ButtonChangePassword" Content="Смена пароля" ToolTip="Изменить пароль" Click="ButtonChangePassword_Click"/>
        </StackPanel>

        <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed">
            <TextBlock Text="Слишком много неверных попыток. Введите капчу." TextWrapping="Wrap" TextAlignment="Center" Width="260" Margin="0,0,0,5"/>
            <TextBox x:Name="CaptchaText" Height="50" FontSize="24" FontWeight="Bold" FontStyle="Italic" IsReadOnly="True" HorizontalContentAlignment="Center" Foreground="{DynamicResource DangerBrush}" ContextMenu="{x:Null}" ToolTip="Капчу нельзя скопировать, введите ее вручную" CommandManager.PreviewExecuted="CaptchaText_PreviewExecuted"/>
            <Grid>
                <TextBox x:Name="CaptchaInput" MaxLength="6" ToolTip="Введите символы, показанные выше" TextChanged="CaptchaInput_TextChanged"/>
                <TextBlock x:Name="HintCaptcha" Text="Введите капчу" Style="{DynamicResource HintText}"/>
            </Grid>
            <Button x:Name="ButtonCaptcha" Content="Подтвердить" ToolTip="Подтвердить ввод капчи" Click="ButtonCaptcha_Click"/>
        </StackPanel>
    </StackPanel>
</Page>
